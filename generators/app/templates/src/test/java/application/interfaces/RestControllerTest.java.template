package <%= base_package_name %>.application.interfaces;

import <%= base_package_name %>.application.service.<%= entity_name %>Service;
import <%= base_package_name %>.domain.model.<%= entity_name %>;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageImpl;
import org.springframework.data.domain.PageRequest;
import org.springframework.data.domain.Pageable;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;
import org.springframework.test.web.servlet.setup.MockMvcBuilders;

import java.util.Arrays;
import java.util.List;
import java.util.Optional;

import static org.hamcrest.Matchers.hasSize;
import static org.hamcrest.Matchers.is;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;
import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

/**
 * Unit tests for the {@link <%= entity_name %>Controller} REST controller.
 */
@WebMvcTest(<%= entity_name %>Controller.class)
class <%= entity_name %>ControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockBean
    private <%= entity_name %>Service <%= entity_name.toLowerCase() %>Service;

    @Autowired
    private ObjectMapper objectMapper;

    private <%= entity_name %> <%= entity_name.toLowerCase() %>;

    @BeforeEach
    void setUp() {
        <%= entity_name.toLowerCase() %> = new <%= entity_name %>();
        // Set up your test entity with required fields
        // <%= entity_name.toLowerCase() %>.setId(1L);
        // <%= entity_name.toLowerCase() %>.setName("Test <%= entity_name %>");
    }

    <% if (crudOperations && crudOperations.enabled) { %>
    @Test
    void shouldGetAll<%= entity_name %>s() throws Exception {
        // given
        List<<%= entity_name %>> <%= entity_name.toLowerCase() %>List = Arrays.asList(<%= entity_name.toLowerCase() %>);
        Page<<%= entity_name %>> <%= entity_name.toLowerCase() %>Page = new PageImpl<>(<%= entity_name.toLowerCase() %>List);
        when(<%= entity_name.toLowerCase() %>Service.findAll(any(Pageable.class))).thenReturn(<%= entity_name.toLowerCase() %>Page);

        // when/then
        mockMvc.perform(get("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.content", hasSize(1)))
                .andExpect(jsonPath("$.totalElements", is(1)));
    }

    @Test
    void shouldGet<%= entity_name %>ById() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.of(<%= entity_name.toLowerCase() %>));

        // when/then
        mockMvc.perform(get("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L)
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id", is(1)));
    }

    @Test
    void shouldReturnNotFoundWhen<%= entity_name %>DoesNotExist() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.empty());

        // when/then
        mockMvc.perform(get("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L)
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isNotFound());
    }

    @Test
    void shouldCreate<%= entity_name %>() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.save(any(<%= entity_name %>.class))).thenReturn(<%= entity_name.toLowerCase() %>);

        // when/then
        mockMvc.perform(post("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(<%= entity_name.toLowerCase() %>)))
                .andExpect(status().isCreated())
                .andExpect(jsonPath("$.id", is(1)));
    }

    @Test
    void shouldReturnBadRequestWhenCreating<%= entity_name %>WithId() throws Exception {
        // given
        <%= entity_name.toLowerCase() %>.setId(1L);

        // when/then
        mockMvc.perform(post("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s")
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(<%= entity_name.toLowerCase() %>)))
                .andExpect(status().isBadRequest());
    }

    @Test
    void shouldUpdate<%= entity_name %>() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.of(<%= entity_name.toLowerCase() %>));
        when(<%= entity_name.toLowerCase() %>Service.save(any(<%= entity_name %>.class))).thenReturn(<%= entity_name.toLowerCase() %>);

        // when/then
        mockMvc.perform(put("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(<%= entity_name.toLowerCase() %>)))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.id", is(1)));
    }

    @Test
    void shouldReturnNotFoundWhenUpdatingNonExistent<%= entity_name %>() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.empty());

        // when/then
        mockMvc.perform(put("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L)
                .contentType(MediaType.APPLICATION_JSON)
                .content(objectMapper.writeValueAsString(<%= entity_name.toLowerCase() %>)))
                .andExpect(status().isNotFound());
    }

    @Test
    void shouldDelete<%= entity_name %>() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.of(<%= entity_name.toLowerCase() %>));
        doNothing().when(<%= entity_name.toLowerCase() %>Service).delete(1L);

        // when/then
        mockMvc.perform(delete("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L))
                .andExpect(status().isNoContent());

        verify(<%= entity_name.toLowerCase() %>Service).delete(1L);
    }

    @Test
    void shouldReturnNotFoundWhenDeletingNonExistent<%= entity_name %>() throws Exception {
        // given
        when(<%= entity_name.toLowerCase() %>Service.findOne(1L)).thenReturn(Optional.empty());

        // when/then
        mockMvc.perform(delete("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s/{id}", 1L))
                .andExpect(status().isNotFound());

        verify(<%= entity_name.toLowerCase() %>Service, never()).delete(any());
    }
    <% } %>

    <% if (endpoints && endpoints.length > 0) { %>
    <% endpoints.forEach(function(endpoint) { %>
    @Test
    void should<%= endpoint.name.charAt(0).toUpperCase() + endpoint.name.slice(1) %>() throws Exception {
        // TODO: Implement test for custom endpoint <%= endpoint.name %>
        // This is a placeholder test that should be implemented based on the specific endpoint requirements
        mockMvc.perform(<%= endpoint.method.toLowerCase() %>("<%= api_context_path %>/<%= entity_name.toLowerCase() %>s<%= endpoint.path %>")
                .contentType(MediaType.APPLICATION_JSON))
                .andExpect(status().isNotImplemented());
    }
    <% }); %>
    <% } %>
} 