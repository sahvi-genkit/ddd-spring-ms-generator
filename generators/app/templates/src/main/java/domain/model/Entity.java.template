package <%= base_package_name %>.domain.model;

import lombok.Data;
import lombok.NoArgsConstructor;
import lombok.AllArgsConstructor;
import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;
import java.util.HashMap;
import jakarta.persistence.Entity;
import jakarta.persistence.Id;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Column;
import jakarta.persistence.Embedded;
import jakarta.validation.constraints.NotNull;
import jakarta.validation.constraints.Size;
import jakarta.validation.constraints.Email;
import jakarta.validation.constraints.Pattern;
import jakarta.validation.constraints.Min;
import jakarta.validation.constraints.Max;
import jakarta.validation.constraints.NotBlank;
import jakarta.validation.constraints.NotEmpty;
import jakarta.validation.constraints.Positive;
import jakarta.validation.constraints.PositiveOrZero;
import jakarta.validation.constraints.Negative;
import jakarta.validation.constraints.NegativeOrZero;
import jakarta.validation.constraints.DecimalMin;
import jakarta.validation.constraints.DecimalMax;
import jakarta.validation.constraints.Digits;
import jakarta.validation.constraints.Past;
import jakarta.validation.constraints.PastOrPresent;
import jakarta.validation.constraints.Future;
import jakarta.validation.constraints.FutureOrPresent;
import jakarta.persistence.Table;

@Data
@NoArgsConstructor
@AllArgsConstructor
@Entity
@Table(name = "<%= entity.tableName %>")
public class <%= entity.name %> {
    <% if (!entity.fields.some(f => f.type === 'ValueObject' && f.name === 'id')) { %>
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;
    <% } %>

    <% fields.forEach(function(field) { %>
    <% if (field.type === 'ValueObject') { %>
    @Embedded
    <% if (field.required) { %>
    @NotNull(message = "<%= field.description %> is required")
    <% } %>
    private <%= field.valueObject %> <%= field.name %>;
    <% } else { %>
    <% if (field.required) { %>
    @NotNull
    <% } %>
    <% if (field.validations) { %>
    <% field.validations.forEach(function(validation) { %>
    <% if (validation.type === 'NotBlank') { %>
    @NotBlank(message = "<%= validation.message %>")
    <% } else if (validation.type === 'Size') { %>
    @Size(min = <%= validation.min %>, max = <%= validation.max %>, message = "<%= validation.message %>")
    <% } else if (validation.type === 'Pattern') { %>
    @Pattern(regexp = "<%= validation.regexp %>", message = "<%= validation.message %>")
    <% } else if (validation.type === 'Min') { %>
    @Min(value = <%= validation.value %>, message = "<%= validation.message %>")
    <% } else if (validation.type === 'Max') { %>
    @Max(value = <%= validation.value %>, message = "<%= validation.message %>")
    <% } else if (validation.type === 'DecimalMin') { %>
    @DecimalMin(value = "<%= validation.value %>", message = "<%= validation.message %>")
    <% } else if (validation.type === 'DecimalMax') { %>
    @DecimalMax(value = "<%= validation.value %>", message = "<%= validation.message %>")
    <% } else if (validation.type === 'Digits') { %>
    @Digits(integer = <%= validation.integer %>, fraction = <%= validation.fraction %>, message = "<%= validation.message %>")
    <% } else if (validation.type === 'Past') { %>
    @Past(message = "<%= validation.message %>")
    <% } else if (validation.type === 'PastOrPresent') { %>
    @PastOrPresent(message = "<%= validation.message %>")
    <% } else if (validation.type === 'Future') { %>
    @Future(message = "<%= validation.message %>")
    <% } else if (validation.type === 'FutureOrPresent') { %>
    @FutureOrPresent(message = "<%= validation.message %>")
    <% } %>
    <% }); %>
    <% } %>
    @Column<% if (field.name !== field.name.toLowerCase()) { %>(name = "<%= field.name.toLowerCase() %>")<% } %><% if (field.unique) { %>(unique = true)<% } %>
    private <%= field.type %> <%= field.name %>;
    <% } %>
    <% }); %>
}
